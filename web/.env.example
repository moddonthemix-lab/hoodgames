# Copy to .env.local and fill in. See config/chains.ts and config/contracts.ts.

# --- Chain selection ---
# "local" (default) targets Anvil at http://127.0.0.1:8545. Set to anything else to target
# Robinhood Chain / its testnet fallback instead.
NEXT_PUBLIC_CHAIN_ENV=local

# --- Robinhood Chain (TODO: fill in from official developer docs, see config/chains.ts) ---
NEXT_PUBLIC_ROBINHOOD_RPC_URL=
NEXT_PUBLIC_ROBINHOOD_EXPLORER_URL=
NEXT_PUBLIC_USE_ARBITRUM_SEPOLIA=false
NEXT_PUBLIC_ROBINHOOD_TESTNET_CHAIN_ID=
NEXT_PUBLIC_ROBINHOOD_TESTNET_RPC_URL=

# --- WalletConnect (get one at https://cloud.walletconnect.com) ---
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Deployed contract addresses (from contracts/script/Deploy.s.sol output) ---
NEXT_PUBLIC_FUND_NFT_ADDRESS=
NEXT_PUBLIC_GAME_TOKEN_ADDRESS=
NEXT_PUBLIC_GAME_ENGINE_ADDRESS=
NEXT_PUBLIC_REWARDS_DISTRIBUTOR_ADDRESS=
NEXT_PUBLIC_AUM_STAKING_ADDRESS=

# --- Payout convert-step (MARGIN_SPEC.md section 4 / Phase 4) ---
# Global kill switch, independent of the geo-gate — leave false until legal review is done.
NEXT_PUBLIC_CONVERT_STEP_ENABLED=false
